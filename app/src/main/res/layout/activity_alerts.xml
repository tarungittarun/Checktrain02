<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="@dimen/gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/TextHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/alerts"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/intro"
        style="@style/TextMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Manage every active train alert and review completed, missed, stopped or cancelled alerts. Station triggers use fresh route-matched source reports; phone-distance triggers use this phone's location. Website clocks and timetable echoes never trigger an alert." />

    <ScrollView
        android:id="@+id/alertsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/alertsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/clearHistory"
        style="@style/BtnGhost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clear alert history"
        android:visibility="gone" />
</LinearLayout>
