<?xml version="1.0" encoding="utf-8"?>
<!--
  One search result = one *run* of a train. Departure and arrival own the left edge because that is what
  a traveller scans; identity and qualifiers sit in the middle; the right column answers the only two
  questions left at that point - "can I still catch it" and "how do I watch it".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_inset"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:minWidth="66dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hitDep"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text1"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/hitArr"
            style="@style/TextClockDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <View
        android:layout_width="2dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:background="@color/stroke" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hitNo"
            style="@style/TextCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/hitName"
            style="@style/TextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/hitMeta"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hitTag"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/hitGo"
            style="@style/TextMicro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/track"
            android:textColor="@color/accent" />
    </LinearLayout>
</LinearLayout>
