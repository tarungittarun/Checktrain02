<?xml version="1.0" encoding="utf-8"?>
<!--
  One stop, the owner's arrangement (round 45): ARRIVAL on the left, STATION in the middle, DEPARTURE
  on the right. Each time column stacks its SCHEDULED minute above its ACTUAL/EXPECTED minute, every
  minute prefixed (Sch / Act / Est) so no number can be mistaken for the other kind - the reader line
  with the source name moved OUT of the rows: the source is named once, in the dropdown above the
  table, not repeated per halt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

<LinearLayout
    android:id="@+id/stopRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="@dimen/row_min_h"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="@dimen/col_sched"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schedArr"
            style="@style/TextClockDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/liveArr"
            style="@style/TextClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="@dimen/rail_w"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/stroke" />

        <View
            android:id="@+id/stopDot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="7dp"
            android:background="@drawable/dot_later" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stopName"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2" />

        <TextView
            android:id="@+id/stopMeta"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/stopStatus"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:textColor="@color/warn" />

        <TextView
            android:id="@+id/stopReport"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/warn"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/col_live"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schedDep"
            style="@style/TextClockDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/liveDep"
            style="@style/TextClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal" />
    </LinearLayout>
</LinearLayout>

<LinearLayout
    android:id="@+id/inlineLegGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <in.opentrack.india.ui.InlineLegView
        android:id="@+id/inlineLeg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/inlineLegCaption"
        style="@style/TextMicro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/warn" />
</LinearLayout>

<LinearLayout
    android:id="@+id/intermediateGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_inset"
    android:orientation="vertical"
    android:paddingStart="130dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone" />
</LinearLayout>
