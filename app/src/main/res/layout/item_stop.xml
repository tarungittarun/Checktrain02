<?xml version="1.0" encoding="utf-8"?>
<!-- A journey timeline, not a three-column timetable. The one glance: stop, state,
     and the most useful time. Tap a stop for its fully labelled comparison. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/stopRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp">
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@color/stroke" />
            <View
                android:id="@+id/stopDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="9dp"
                android:background="@drawable/dot_later" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/haltMarker"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/live"
                android:visibility="gone" />
            <TextView
                android:id="@+id/stopName"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/stopMeta"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2" />
            <TextView
                android:id="@+id/stopStatus"
                style="@style/TextMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2" />
            <TextView
                android:id="@+id/stopReport"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/stopPrimaryTime"
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="2" />
            <TextView
                android:id="@+id/stopTimeType"
                style="@style/TextMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/stopToggle"
                style="@style/TextMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Details  ▾"
                android:textColor="@color/live" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full schedule / actual comparison is progressive disclosure. The IDs stay stable
         for accessibility and device tests, even when the row is collapsed. -->
    <LinearLayout
        android:id="@+id/stopDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_inset"
        android:orientation="vertical"
        android:paddingStart="65dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">
        <TextView style="@style/TextLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ARRIVAL" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/schedArr" style="@style/TextClockDim"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView android:id="@+id/liveArr" style="@style/TextClock"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView style="@style/TextLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:text="DEPARTURE" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/schedDep" style="@style/TextClockDim"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView android:id="@+id/liveDep" style="@style/TextClock"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inlineLegGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="64dp" android:paddingEnd="12dp">
            <TextView
                android:id="@+id/inlineLegCaption"
                style="@style/TextMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/inlineLegAge"
                style="@style/TextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/live" />
        </LinearLayout>
        <in.opentrack.india.ui.InlineLegView
            android:id="@+id/inlineLeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/routeToggle"
            style="@style/TextMeta"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="64dp"
            android:textColor="@color/live" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/intermediateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_inset"
        android:orientation="vertical"
        android:paddingStart="65dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />
</LinearLayout>
