<?xml version="1.0" encoding="utf-8"?>
<!-- Times stay next to each stop. The left pair is the timetable; the right pair
     is the selected source. A tap discloses intermediate stations, not the time sheet. -->
<in.opentrack.india.ui.RouteStopGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/stopRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp">
            <View
                android:id="@+id/stopDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="9dp"
                android:background="@drawable/dot_later" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/haltMarker"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/live"
                android:visibility="gone" />
            <TextView
                android:id="@+id/stopName"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/stopMeta"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2" />
            <TextView
                android:id="@+id/stopStatus"
                style="@style/TextMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/schedArr"
                    style="@style/TextClockDim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Scheduled arrival" />
                <TextView
                    android:id="@+id/schedDep"
                    style="@style/TextClockDim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:contentDescription="Scheduled departure" />
            </LinearLayout>
            <TextView
                android:id="@+id/stopReport"
                style="@style/TextMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/liveArr"
                style="@style/TextClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end" />
            <TextView
                android:id="@+id/liveDep"
                style="@style/TextClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end" />
            <TextView
                android:id="@+id/stopPrimaryTime"
                style="@style/TextMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:id="@+id/stopTimeType"
                style="@style/TextMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:id="@+id/stopToggle"
                style="@style/TextMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Stations  ▾"
                android:textColor="@color/live" />
        </LinearLayout>
    </LinearLayout>

    <!-- Retained as a hidden compatibility anchor for instrumentation; no time sheet. -->
    <LinearLayout
        android:id="@+id/stopDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/inlineLegGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="64dp" android:paddingEnd="12dp">
            <TextView
                android:id="@+id/inlineLegCaption"
                style="@style/TextMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/inlineLegAge"
                style="@style/TextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/live" />
            <TextView
                android:id="@+id/routeToggle"
                style="@style/TextMeta"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/live" />
        </LinearLayout>
        <in.opentrack.india.ui.InlineLegView
            android:id="@+id/inlineLeg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Names and proportional dots are painted INSIDE inlineLeg, never in a second card. -->
</in.opentrack.india.ui.RouteStopGroup>
