<?xml version="1.0" encoding="utf-8"?>
<!--
  One stop. Scheduled pair and live-or-expected pair are stacked in two fixed-width columns so the eye
  reads down a column and sees the drift; the rail on the left is the same timeline the chart draws, so
  "passed / here / still to come" is legible without reading a word. Column widths come from dimens.xml
  and are repeated verbatim in the table header - a header that does not line up with its own table is
  how a screen starts to look untrustworthy.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stopRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="@dimen/row_min_h"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="9dp"
    android:paddingRight="12dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="@dimen/rail_w"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/stroke" />

        <View
            android:id="@+id/stopDot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="7dp"
            android:background="@drawable/dot_later" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--
            Two lines, not one, for the name and for the "code · km · note" line under it. Both were
            `singleLine`, which is how the shipping screens ended up reading "SMET · 274 km · you g…" on the
            last row: the boarding note is the one line a traveller needs to see to trust that the leg is
            marked, and it was the exact thing the width could not hold. `ellipsize` stays for names long
            enough to need a third line, so a wrap is the normal outcome and a cut is the exception.
        -->
        <TextView
            android:id="@+id/stopName"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2" />

        <TextView
            android:id="@+id/stopMeta"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2" />

        <!-- The traveller-report sentence (ADR-006), its own line so an unofficial minute can never
             be mistaken for the schedule or the live estimate beside it. -->
        <TextView
            android:id="@+id/stopReports"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:textColor="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/col_sched"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schedArr"
            style="@style/TextClockDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/schedDep"
            style="@style/TextClockDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/col_live"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/liveArr"
            style="@style/TextClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/liveDep"
            style="@style/TextClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/liveTag"
            style="@style/TextMicro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_horizontal"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
