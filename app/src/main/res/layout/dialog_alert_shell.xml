<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alertDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alert_dialog"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/alertEyebrow"
        style="@style/FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JOURNEY ALERT"
        android:textColor="@color/accent" />

    <TextView
        android:id="@+id/alertTitle"
        style="@style/TextHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text1" />

    <TextView
        android:id="@+id/alertSubtitle"
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@color/stroke" />

    <ScrollView
        android:id="@+id/alertDialogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/alertDialogBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/stroke" />

    <LinearLayout
        android:id="@+id/alertDialogFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alertCancel"
            style="@style/BtnGhost"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cancel"
            android:textAllCaps="false" />

        <View
            android:id="@+id/alertFooterSpacer"
            android:layout_width="10dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alertPrimary"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Set alert"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
