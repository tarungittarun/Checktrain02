<?xml version="1.0" encoding="utf-8"?>
<!--
  No Material Components in this project, on purpose (see docs/ARCHITECTURE.md, "Rejected
  alternatives"): the widget library is ~1.5 MB of the APK and its theme contract drags in
  ConstraintLayout, a dynamic-colour stack and a type scale we would override anyway. What a modern
  screen actually needs is a small number of decisions - one accent, one radius, a real type
  hierarchy, generous insets, touch feedback - and those are a few hundred lines of XML here.

  Text appearances carry the hierarchy so layouts stay declarative; `TextLabel` is what makes the
  columns of the route table legible at a glance, which is the difference between a data dump and a
  timetable.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.OpenTrack" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text1</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:colorControlNormal">@color/stroke</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:fontFamily" tools:targetApi="21">sans-serif</item>
    </style>

    <!-- Type ladder. Sizes are sp, weights carry the meaning; nothing in the app invents a size. -->
    <style name="TextNumeral">
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextHeadline">
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextMeta">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextMicro">
        <item name="android:textColor">@color/text3</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Column header of a table. -->
    <style name="TextLabel">
        <item name="android:textColor">@color/text3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Times must align in columns; a proportional font makes a timetable unreadable. -->
    <style name="TextClock">
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextClockDim">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextCode">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/ripple_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="EditField">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">textCapCharacters|textNoSuggestions</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:importantForAutofill" tools:targetApi="26">no</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:background">@drawable/ripple_btn_primary</item>
        <item name="android:textColor">@color/ink_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BtnGhost">
        <item name="android:background">@drawable/ripple_btn_ghost</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Pill">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Segment">
        <item name="android:background">@drawable/ripple_segment</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">54dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
